# Host-only systemd EnvironmentFile, root-owned 0600; not a Docker env file.
# Copy outside Git to /etc/belsen/backup.env. No R2 action is authorized by this template.
BELSEN_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BELSEN_R2_BUCKET=<PRIVATE_DEDICATED_BUCKET>
# /etc/belsen/r2-credentials is separate root-owned 0600, with profile [belsen-r2].
# aws_access_key_id and aws_secret_access_key belong only in that protected file.
# Token: Object Read & Write scoped to this bucket only; no account/bucket administration.
# The bucket/prefix lifecycle is configured separately by an approved administrator.
# /etc/belsen/backup-recipients.txt contains public age recipient(s), never a private identity.
