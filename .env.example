# Backend configuration. Copy to ignored .env and fill all six required values.
# Source only a trusted local .env; Spring Boot does not load it automatically.

# Required: Compose database initialization
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Required: backend connection; use the same database/user/password as above.
# Local URL format: jdbc:postgresql://127.0.0.1:5433/<your-database-name>
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Optional overrides; uncomment only when changing the documented defaults.
# BELSEN_POSTGRES_PORT=5433
# BELSEN_SERVER_PORT=8081
# BELSEN_SESSION_TIMEOUT=30m

# The local profile is selected in the startup command, not by default.
# Production always uses Secure cookies; local allows HTTP on loopback only.

# Optional Google OIDC: disabled by default. Uncomment all three to enable.
# BELSEN_GOOGLE_ENABLED=true
# BELSEN_GOOGLE_CLIENT_ID=
# BELSEN_GOOGLE_CLIENT_SECRET=
# Future deployment/AI settings
# BELSEN_PUBLIC_BASE_URL=
# BELSEN_AI_PROVIDER=
# BELSEN_AI_MODEL=
# BELSEN_AI_API_KEY=
# BELSEN_AI_DAILY_REQUEST_LIMIT=
# BELSEN_AI_MAX_OUTPUT_TOKENS=
# BELSEN_AI_TIMEOUT_SECONDS=

# Never expose credentials through VITE_* variables or frontend bundles.
