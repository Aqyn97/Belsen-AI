# Proposed configuration contract; no application consumes these values yet.
# Copy to an ignored local .env only when setup instructions are implemented.
# Spring Boot will need explicit environment injection; it does not load .env automatically.

# PostgreSQL container initialization
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend database connection
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Deployment and session settings
BELSEN_PUBLIC_BASE_URL=
BELSEN_ALLOWED_ORIGIN=
BELSEN_SESSION_COOKIE_SECURE=
SERVER_SERVLET_SESSION_TIMEOUT=

# Google OAuth2; register the exact callback URL with Google.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Server-side AI configuration; provider, model and limits remain undecided.
BELSEN_AI_PROVIDER=
BELSEN_AI_MODEL=
BELSEN_AI_API_KEY=
BELSEN_AI_DAILY_REQUEST_LIMIT=
BELSEN_AI_MAX_OUTPUT_TOKENS=
BELSEN_AI_TIMEOUT_SECONDS=

# Never expose credentials through VITE_* variables or frontend bundles.
