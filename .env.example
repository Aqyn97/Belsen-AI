# Backend configuration. Copy to ignored .env and fill all six required values.
# Source only a trusted local .env; Spring Boot does not load it automatically.

# Required: Compose database initialization
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Required: backend connection; use the same database/user/password as above.
# Local URL format: jdbc:postgresql://127.0.0.1:5433/<your-database-name>
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Optional overrides; uncomment only when changing the documented defaults.
# BELSEN_POSTGRES_PORT=5433
# BELSEN_SERVER_PORT=8081
# BELSEN_SESSION_TIMEOUT=30m

# The local profile is selected in the startup command, not by default.
# Production always uses Secure cookies; local allows HTTP on loopback only.

# Optional Google OIDC: disabled by default. Uncomment all three to enable.
# BELSEN_GOOGLE_ENABLED=true
# BELSEN_GOOGLE_CLIENT_ID=
# BELSEN_GOOGLE_CLIENT_SECRET=
# Production only: see docs/DEPLOYMENT.md. Do not combine production and local.
# SPRING_PROFILES_ACTIVE=production
# BELSEN_PUBLIC_BASE_URL=https://belsen.example
# BELSEN_TLS_KEY_STORE=file:/secure/belsen/server.p12
# BELSEN_TLS_KEY_STORE_PASSWORD=
# BELSEN_BIND_ADDRESS=127.0.0.1
# BELSEN_DB_POOL_MAX=10
# BELSEN_DB_POOL_MIN=2
# Direct TLS is enabled; forwarded headers are ignored by default.
# BELSEN_TLS_ENABLED=true
# BELSEN_FORWARD_HEADERS_STRATEGY=none
# Proxy mode requires TLS_ENABLED=false, FORWARD_HEADERS_STRATEGY=native,
# an exact trusted-proxy regex, a stripping TLS proxy and a private backend listener.
# BELSEN_TRUSTED_PROXY_REGEX=127[.]0[.]0[.]1|::1
# Build flag only: expose the Google button only when the server is configured.
# VITE_GOOGLE_ENABLED=false

# Future AI settings (not implemented)
# BELSEN_AI_PROVIDER=
# BELSEN_AI_MODEL=
# BELSEN_AI_API_KEY=
# BELSEN_AI_DAILY_REQUEST_LIMIT=
# BELSEN_AI_MAX_OUTPUT_TOKENS=
# BELSEN_AI_TIMEOUT_SECONDS=

# Never expose credentials through VITE_* variables or frontend bundles.

# Day 7 B2 Groq Free integration, disabled by default.
# Keep disabled until actual Groq console Free-plan/ZDR review.
BELSEN_COACH_ENABLED=false
BELSEN_COACH_API_KEY=
BELSEN_COACH_FREE_PLAN_CONFIRMED=false
BELSEN_COACH_PRIVACY_REVIEWED=false
# Only these exact model/endpoint values are accepted; no substitution/fallback.
BELSEN_COACH_MODEL=openai/gpt-oss-20b
BELSEN_COACH_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
BELSEN_COACH_CONNECT_SECONDS=3
BELSEN_COACH_DEADLINE_SECONDS=15
BELSEN_COACH_MAX_INPUT_BYTES=12288
BELSEN_COACH_MAX_OUTPUT_TOKENS=512
